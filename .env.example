# Upstox. UPSTOX_REDIRECT_URI must exactly match the redirect URI
# registered in your Upstox developer app - api-gateway owns this route
# (the dashboard's "Connect Upstox" button), not a separate script.
# UPSTOX_TOKEN_FILE is only a local-dev fallback; data-engine prefers
# the token api-gateway writes to Supabase's upstox_tokens table.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback
UPSTOX_TOKEN_FILE=token.json

# Redis (shared by all engines, local service name in docker-compose)
REDIS_URL=redis://redis:6379/0

# Supabase (risk-engine, execution-engine, api-gateway)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paper trading
PAPER_CAPITAL=100000

# data-engine: comma-separated Upstox instrument keys to subscribe to
# (e.g. "NSE_INDEX|Nifty 50,NSE_EQ|INE002A01018"); defaults to just
# NSE_INDEX|Nifty 50 if unset
INSTRUMENT_KEYS=NSE_INDEX|Nifty 50
CANDLE_TIMEFRAME_SECONDS=300
UPSTOX_FEED_MODE=ltpc
