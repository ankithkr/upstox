# Upstox (data-engine live feed; later also execution-engine for live orders)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5000/callback
UPSTOX_TOKEN_FILE=token.json

# Redis (shared by all engines, local service name in docker-compose)
REDIS_URL=redis://redis:6379/0

# Supabase (risk-engine, execution-engine, api-gateway)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paper trading
PAPER_CAPITAL=100000

# data-engine: comma-separated Upstox instrument keys to subscribe to
# (e.g. "NSE_INDEX|Nifty 50,NSE_EQ|INE002A01018"); defaults to just
# NSE_INDEX|Nifty 50 if unset
INSTRUMENT_KEYS=NSE_INDEX|Nifty 50
CANDLE_TIMEFRAME_SECONDS=300
UPSTOX_FEED_MODE=ltpc
