# Upstox (data-engine live feed; later also execution-engine for live orders)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5000/callback
UPSTOX_TOKEN_FILE=token.json

# Redis (shared by all engines, local service name in docker-compose)
REDIS_URL=redis://redis:6379/0

# Supabase (risk-engine, execution-engine, api-gateway)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paper trading
PAPER_CAPITAL=100000
